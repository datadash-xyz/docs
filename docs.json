{
  "theme": "mint",
  "name": "Datadash Docs",
  "colors": {
    "primary": "#8b5cf6",
    "light": "#8b5cf6",
    "dark": "#8b5cf6"
  },
  "logo": {
    "light": "/images/logo-wordmark.svg",
    "dark": "/images/logo-wordmark.svg"
  },
  "favicon": {
    "light": "/images/favicon.svg",
    "dark": "/images/favicon.svg"
  },
  "appearance": {
    "default": "dark"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://datadash.xyz"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/datadashxyz"
    }
  },
  "fonts": {
    "family": "Geist",
    "weight": 500
  },
  "icons": {
    "library": "lucide"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ],
    "display": "header"
  },
  "thumbnails": {
    "fonts": {
      "family": "Geist"
    }
  },
  "navigation": {
    "global--old": {
      "anchors": [
        {
          "anchor": "Documentation",
          "icon": "book-open-cover",
          "href": "https://mintlify.com/docs"
        },
        {
          "anchor": "Blog",
          "icon": "newspaper",
          "href": "https://mintlify.com/blog"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["index"]
          },
          {
            "group": "Features",
            "pages": ["activity", "holders", "smart-money", "signals", "cohorts"]
          },
          {
            "group": "Using the API",
            "pages": ["api-keys", "filters"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.json"
      }
    ]
  },
  "api": {
    "openapi": "openapi.json"
  }
}
